/*
unordered_set stores unique values

Header file:
#include <unordered_set>

Syntax:
unordered_set<data_type> set_name;

Example:
unordered_set<int> us;

Important points:
1. Stores only unique values
2. Unordered storage
3. Faster searching using hashing
4. Duplicate values are ignored
5. No indexing
*/

#include <iostream>
#include <unordered_set>
using namespace std;

int main()
{
    // ================= CREATE =================

    unordered_set<int> us; // empty unordered_set

    us.insert(10); // insert() adds value

    us.insert(20);

    us.insert(30);

    us.insert(10); // duplicate value ignored

    cout << "unordered_set elements: ";

    for(int x : us)
    {
        cout << x << " ";
    }

    /*
    Output can be:
    30 20 10

    Order is not fixed
    */

    cout << endl << endl;


    // insert() inserts new value

    us.insert(50);

    cout << "After insert(): ";

    for(int x : us)
    {
        cout << x << " ";
    }

    /*
    Output can be:
    50 30 20 10
    */

    cout << endl << endl;



    // ================= READ =================

    cout << "us.size(): " << us.size() << endl; // size() returns total unique elements
    // Output: us.size(): 4

    cout << "us.empty(): " << us.empty() << endl; // empty() checks set is empty or not
    // Output: us.empty(): 0

    cout << endl;


    // find() searches value

    if(us.find(20) != us.end())
    {
        cout << "20 found" << endl;
    }

    // Output: 20 found

    cout << endl;


    // count() checks value exists or not

    cout << "count(10): " << us.count(10) << endl;
    // Output: count(10): 1

    cout << "count(100): " << us.count(100) << endl;
    // Output: count(100): 0

    cout << endl;



    // ================= UPDATE =================

    // unordered_set values cannot be updated directly

    // remove old value and insert new value

    us.erase(20);

    us.insert(200);

    cout << "After update:" << endl;

    for(int x : us)
    {
        cout << x << " ";
    }

    /*
    Output can be:
    200 50 30 10
    */

    cout << endl << endl;



    // ================= DELETE =================

    us.erase(30); // erase() removes value

    cout << "After erase(30): ";

    for(int x : us)
    {
        cout << x << " ";
    }

    /*
    Output can be:
    200 50 10
    */

    cout << endl << endl;


    us.clear(); // clear() removes all elements

    cout << "us.empty(): " << us.empty() << endl;
    // Output: us.empty(): 1

    return 0;
}